# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis (12 caractères au moins)
APPS_PASSWORD=change-moi-12-caracteres-minimum

# Clé d'API créée dans Immich pour Sillage, limitée à la lecture :
# person.read, asset.read, asset.view, album.read
SILLAGE_IMMICH_CLE=

# Dossier du NAS pour l'état de Sillage
SILLAGE_DATA_DIR=/volume1/docker/sillage

# Facultatif
# PORT_SILLAGE=8093
# SILLAGE_IMMICH_ADRESSE=http://adresse-d-immich:2283
# SILLAGE_MOTS=mariage,baptême,anniversaire
